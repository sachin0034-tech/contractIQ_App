# Supabase
NEXT_PUBLIC_SUPABASE_URL=                 # Supabase project URL: Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # Supabase anon/public key: Dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY=                # SERVER ONLY. Service role key: Dashboard > Settings > API. Used only by the retention cron route

# Azure AI Foundry agent (AI provider)
AZURE_API_KEY=                            # SERVER ONLY. Foundry portal > your project > Settings > API keys
AZURE_AGENT_ENDPOINT=                     # SERVER ONLY. Foundry portal > Agents > your agent > Endpoint (services.ai.azure.com, ends in /responses). Do not edit it
AZURE_API_VERSION=                        # Optional. api-version query parameter. Defaults to v1
AI_REQUEST_TIMEOUT_MS=                    # Optional, SERVER ONLY. Per-call timeout in ms. Defaults to 55000
AI_MONTHLY_BUDGET_USD=                    # Optional, SERVER ONLY. Monthly AI spend budget in USD for the 80% cost alert log
EXPOSE_ERROR_DETAILS=                     # Optional, SERVER ONLY. "true" returns raw upstream error text in API errors in production; always on outside production

# App
NEXT_PUBLIC_APP_URL=                      # Public base URL, e.g. http://localhost:3000 locally, https://<site>.netlify.app in production. Used for auth redirects
NEXT_PUBLIC_CALIBRATION_WARNING=          # "true" shows the UI calibration warning when the monthly eval shows 15% or more miscalibration; otherwise "false"

# Limits (all SERVER ONLY, integers)
MAX_PDF_BYTES=                            # 10485760 (10 MB)
MAX_PDF_PAGES=                            # 20
MAX_CONTRACT_TOKENS=                      # 15000
MIN_CONTRACT_WORDS=                       # 100 (below this the PDF is treated as scanned)
MAX_CUSTOM_TERMS=                         # 5
MAX_CHAT_HISTORY_MESSAGES=                # 200
RATE_LIMIT_UPLOAD_PER_HOUR=               # 20
RATE_LIMIT_PROCESS_PER_HOUR=              # 10
RATE_LIMIT_CHAT_PER_MINUTE=               # 30
RATE_LIMIT_EDIT_PER_MINUTE=               # 120

# Retention cron (Netlify scheduled function calls /api/cron/retention)
CRON_SECRET=                              # SERVER ONLY. Random string (openssl rand -hex 32). Sent as "Authorization: Bearer <value>" by the scheduler
RETENTION_DAYS=                           # 90

# Monitoring
UPTIME_ROBOT_API_KEY=                     # OPTIONAL, SERVER ONLY. uptimerobot.com > My Settings > API. Only needed if monitors are provisioned by script
SLACK_ALERT_WEBHOOK_URL=                  # OPTIONAL, SERVER ONLY. Slack incoming webhook for uptime and cost alerts

# Testing (CI and local only, never set in production)
SUPABASE_TEST_USER_A_EMAIL=               # Test account A used by RLS and E2E tests
SUPABASE_TEST_USER_A_PASSWORD=            # Password for test account A
SUPABASE_TEST_USER_B_EMAIL=               # Test account B used for cross-user isolation tests
SUPABASE_TEST_USER_B_PASSWORD=            # Password for test account B
